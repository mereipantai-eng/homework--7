<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Math Differentiator - Quadratic Functions</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- KaTeX CSS & JS for LaTeX Math Rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js" onload="renderMathInElement(document.body);"></script>
    <style>
        .active-tab {
            border-bottom: 3px solid #3B82F6;
            color: #1D4ED8;
            font-weight: 600;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen font-sans flex flex-col">

    <!-- Header / Navigation -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap justify-between items-center gap-4">
            <div>
                <h1 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                    <span>🧮</span> AI Math Differentiator
                </h1>
                <p class="text-xs text-slate-500">Adaptive Educational Technology Platform</p>
            </div>
            
            <!-- API Key Input Section -->
            <div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-lg border border-slate-200 text-xs">
                <span class="text-slate-600 font-medium">OpenAI Key:</span>
                <input type="password" id="apiKeyInput" placeholder="sk-... (Optional)" class="px-2 py-1 border border-slate-300 rounded bg-white text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 w-36 sm:w-48">
                <span class="text-slate-400 text-[10px]" title="If empty, built-in dynamic simulated response is used">(Demo Mode)</span>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-4 py-8 flex-grow w-full">
        
        <!-- Topic Banner -->
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white p-6 rounded-2xl shadow-sm mb-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <span class="inline-block bg-blue-500/30 text-blue-100 text-xs font-semibold px-2.5 py-1 rounded-full mb-2">Topic 8: Differentiated Learning</span>
                    <h2 class="text-2xl font-extrabold">Quadratic Kinematics: Vertical Motion</h2>
                    <p class="text-blue-100 text-sm mt-1 max-w-2xl">
                        Explore how a single core concept ($h(t) = -5t^2 + v_0 t + h_0$) dynamically adapts across cognitive levels with scaffolded AI support.
                    </p>
                </div>
                <button id="generateBtn" onclick="generateProblem()" class="bg-white text-blue-700 hover:bg-blue-50 font-semibold px-5 py-2.5 rounded-xl text-sm transition shadow-sm flex items-center gap-2 whitespace-nowrap">
                    <span>✨</span> Generate New Problem
                </button>
            </div>
        </div>

        <!-- Level Selector Tabs -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-8">
            <div class="flex border-b border-slate-200 bg-slate-50/50 overflow-x-auto">
                <button onclick="switchLevel(1)" id="tab-1" class="flex-1 min-w-[150px] py-4 px-6 text-sm text-slate-600 font-medium hover:text-blue-600 transition text-center active-tab">
                    Level 1: Foundation
                </button>
                <button onclick="switchLevel(2)" id="tab-2" class="flex-1 min-w-[150px] py-4 px-6 text-sm text-slate-600 font-medium hover:text-blue-600 transition text-center">
                    Level 2: Standard
                </button>
                <button onclick="switchLevel(3)" id="tab-3" class="flex-1 min-w-[150px] py-4 px-6 text-sm text-slate-600 font-medium hover:text-blue-600 transition text-center">
                    Level 3: Advanced
                </button>
            </div>

            <!-- Problem Presentation Area -->
            <div class="p-6 sm:p-8">
                <!-- Level Badge -->
                <div class="flex items-center justify-between mb-4">
                    <span id="levelBadge" class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-3 py-1 rounded-full">
                        Foundation Level • Scaffolded Support
                    </span>
                    <span id="loadingSpinner" class="hidden text-xs text-blue-600 animate-pulse flex items-center gap-1">
                        <svg class="animate-spin h-4 w-4 text-blue-600" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                        AI Generating Math Logic...
                    </span>
                </div>

                <!-- Problem Statement -->
                <div class="mb-6">
                    <h3 class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-2">Problem Statement</h3>
                    <div id="problemContainer" class="text-base sm:text-lg text-slate-800 font-medium leading-relaxed bg-slate-50 p-5 rounded-xl border border-slate-100 min-h-[80px]">
                        Loading problem...
                    </div>
                </div>

                <!-- Guidance & Interactive Hints -->
                <div class="mb-6">
                    <h3 class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-2">Scaffolded Hints & Scaffolding</h3>
                    <div id="hintsContainer" class="space-y-3">
                        <!-- Hints dynamically populated -->
                    </div>
                </div>

                <!-- Detailed Solution Accordion -->
                <div class="border-t border-slate-200 pt-6">
                    <button onclick="toggleSolution()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-3 px-4 rounded-xl text-sm transition flex justify-between items-center">
                        <span>📖 View Full AI Step-by-Step Solution</span>
                        <span id="solutionArrow">▼</span>
                    </button>
                    <div id="solutionBox" class="hidden mt-4 p-5 bg-blue-50/50 rounded-xl border border-blue-100 text-slate-700 text-sm leading-relaxed space-y-3">
                        <!-- Solution populated via JS -->
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-500">
        Course: Educational Technology & AI • Individual Assignment: Web-Based AI Math Differentiator
    </footer>

    <!-- JavaScript Application Logic -->
    <script>
        let currentLevel = 1;

        // Structured Pre-Engineered Adaptive Content (Used in Demo Mode if API Key is not provided)
        const problemData = {
            1: {
                levelTitle: "Foundation Level • Scaffolded Support",
                badgeClass: "bg-emerald-100 text-emerald-800",
                problem: "A ball is thrown directly upward from ground level. Its height $h$ in meters after $t$ seconds is given by the simplified function: <br><br>$$h(t) = -5t^2 + 20t$$<br>Find how many seconds ($t$) it takes for the ball to return back to the ground ($h = 0$).",
                hints: [
                    "Set the height $h(t)$ equal to 0: $-5t^2 + 20t = 0$.",
                    "Factor out common terms: $t(-5t + 20) = 0$.",
                    "Solve for $t$: either $t = 0$ (start) or $-5t + 20 = 0$."
                ],
                solution: "1. **Set $h(t) = 0$:** $$-5t^2 + 20t = 0$$<br>2. **Factor out $t$:** $$t(-5t + 20) = 0$$<br>3. **Find the roots:**<br> - Root 1: $t = 0$ seconds (Launch time)<br> - Root 2: $-5t + 20 = 0 \\implies 5t = 20 \\implies t = 4$ seconds.<br><br>**Answer:** The ball returns to the ground at **$t = 4$ seconds**."
            },
            2: {
                levelTitle: "Standard Grade-Level • Real-World Context",
                badgeClass: "bg-blue-100 text-blue-800",
                problem: "A model rocket is launched vertically from an elevated platform $35$ meters above the ground with an initial velocity of $30\\text{ m/s}$. Its height is given by:<br><br>$$h(t) = -5t^2 + 30t + 35$$<br>Calculate the maximum height reached by the rocket and the exact time it hits the ground.",
                hints: [
                    "Find time to peak height using $t = -b / (2a)$ where $a = -5, b = 30$.",
                    "Substitute peak $t$ back into $h(t)$ to find max height.",
                    "To find total flight time, solve $h(t) = 0$ using the quadratic formula or factoring."
                ],
                solution: "1. **Time to Vertex (Peak):** $$t = -\\frac{b}{2a} = -\\frac{30}{2(-5)} = 3\\text{ seconds}$$<br>2. **Maximum Height:** $$h(3) = -5(3)^2 + 30(3) + 35 = -45 + 90 + 35 = 80\\text{ meters}$$<br>3. **Total Flight Time ($h(t) = 0$):** $$-5t^2 + 30t + 35 = 0 \\implies t^2 - 6t - 7 = 0$$ $$(t - 7)(t + 1) = 0$$<br>Since time cannot be negative, $t = 7$ seconds.<br><br>**Answer:** Max height is **$80$ meters**, total flight time is **$7$ seconds**."
            },
            3: {
                levelTitle: "Advanced Level • Multi-Step Optimization",
                badgeClass: "bg-purple-100 text-purple-800",
                problem: "A drone launches an emergency package from an elevation of $10$ meters. The package height follows $h(t) = -5t^2 + v_0 t + 10$. An defense barrier at $x = 15$ meters horizontal distance requires the package to clear a wall of height $35$ meters at exactly $t = 1$ second.<br><br>Determine required launch velocity $v_0$, max height achieved, and time spent above $30$ meters.",
                hints: [
                    "Substitute $t = 1$ and $h(1) = 35$ to find required $v_0$.",
                    "With $v_0$ known, write the complete height function and locate vertex height.",
                    "Set $h(t) = 30$ and solve for $t_1$ and $t_2$; the duration above $30\\text{m}$ is $t_2 - t_1$."
                ],
                solution: "1. **Solve for $v_0$:** $$35 = -5(1)^2 + v_0(1) + 10 \\implies 35 = 5 + v_0 \\implies v_0 = 30\\text{ m/s}$$<br>2. **Equation:** $$h(t) = -5t^2 + 30t + 10$$<br>3. **Max Height:** Vertex at $t = 3\\text{ s}$, $h(3) = -5(9) + 90 + 10 = 55\\text{ m}$.<br>4. **Duration above 30m:** $$-5t^2 + 30t + 10 = 30 \\implies -5t^2 + 30t - 20 = 0 \\implies t^2 - 6t + 4 = 0$$ Using quadratic formula: $t = 3 \\pm \\sqrt{5}\\text{ s}$. <br>Time duration = $(3 + \\sqrt{5}) - (3 - \\sqrt{5}) = 2\\sqrt{5} \\approx 4.47\\text{ seconds}$."
            }
        };

        function switchLevel(level) {
            currentLevel = level;
            
            // Update Active Tabs
            for (let i = 1; i <= 3; i++) {
                const tab = document.getElementById(`tab-${i}`);
                if (i === level) {
                    tab.classList.add('active-tab');
                } else {
                    tab.classList.remove('active-tab');
                }
            }

            // Hide solution when changing levels
            document.getElementById('solutionBox').classList.add('hidden');
            document.getElementById('solutionArrow').innerText = "▼";

            renderCurrentContent();
        }

        function renderCurrentContent() {
            const data = problemData[currentLevel];
            
            // Render Badge
            const badge = document.getElementById('levelBadge');
            badge.className = `text-xs font-semibold px-3 py-1 rounded-full ${data.badgeClass}`;
            badge.innerText = data.levelTitle;

            // Render Problem
            document.getElementById('problemContainer').innerHTML = data.problem;

            // Render Hints
            const hintsContainer = document.getElementById('hintsContainer');
            hintsContainer.innerHTML = '';
            data.hints.forEach((hint, index) => {
                const hintDiv = document.createElement('div');
                hintDiv.className = "bg-white border border-slate-200 rounded-lg p-3 text-sm";
                hintDiv.innerHTML = `
                    <button onclick="toggleHint(${index})" class="w-full text-left font-medium text-slate-700 flex justify-between items-center">
                        <span>💡 Hint ${index + 1}</span>
                        <span id="hintArrow-${index}" class="text-xs text-blue-600">Show</span>
                    </button>
                    <div id="hintBody-${index}" class="hidden mt-2 text-slate-600 border-t border-slate-100 pt-2">
                        ${hint}
                    </div>
                `;
                hintsContainer.appendChild(hintDiv);
            });

            // Render Solution
            document.getElementById('solutionBox').innerHTML = data.solution;

            // Trigger KaTeX Math Rendering
            if (window.renderMathInElement) {
                renderMathInElement(document.body, {
                    delimiters: [
                        {left: "$$", right: "$$", display: true},
                        {left: "$", right: "$", display: false}
                    ]
                });
            }
        }

        function toggleHint(index) {
            const body = document.getElementById(`hintBody-${index}`);
            const arrow = document.getElementById(`hintArrow-${index}`);
            if (body.classList.contains('hidden')) {
                body.classList.remove('hidden');
                arrow.innerText = "Hide";
            } else {
                body.classList.add('hidden');
                arrow.innerText = "Show";
            }
        }

        function toggleSolution() {
            const box = document.getElementById('solutionBox');
            const arrow = document.getElementById('solutionArrow');
            if (box.classList.contains('hidden')) {
                box.classList.remove('hidden');
                arrow.innerText = "▲";
            } else {
                box.classList.add('hidden');
                arrow.innerText = "▼";
            }
        }

        async function generateProblem() {
            const apiKey = document.getElementById('apiKeyInput').value.trim();
            const spinner = document.getElementById('loadingSpinner');

            if (!apiKey) {
                // If no API key provided, emulate AI generation smoothly
                spinner.classList.remove('hidden');
                setTimeout(() => {
                    spinner.classList.add('hidden');
                    renderCurrentContent();
                }, 600);
                return;
            }

            // Real OpenAI API Integration if Key is provided
            spinner.classList.remove('hidden');
            try {
                const prompt = `Generate a ${currentLevel == 1 ? 'Foundation' : currentLevel == 2 ? 'Standard' : 'Advanced'} quadratic kinematics math problem ($h(t) = -5t^2 + v0*t + h0$). Return JSON format with keys: problem, hint1, hint2, hint3, solution. Use standard LaTeX syntax ($...$ or $$...$$) for math equations.`;

                const response = await fetch("https://api.openai.com/v1/chat/completions", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${apiKey}`
                    },
                    body: JSON.stringify({
                        model: "gpt-4o-mini",
                        messages: [{ role: "user", content: prompt }],
                        response_format: { type: "json_object" }
                    })
                });

                const resData = await response.json();
                const aiResult = JSON.parse(resData.choices[0].message.content);

                problemData[currentLevel].problem = aiResult.problem;
                problemData[currentLevel].hints = [aiResult.hint1, aiResult.hint2, aiResult.hint3];
                problemData[currentLevel].solution = aiResult.solution;

                renderCurrentContent();
            } catch (err) {
                alert("Error contacting OpenAI API. Please check your key or console.");
                console.error(err);
            } finally {
                spinner.classList.add('hidden');
            }
        }

        // Initialize default view
        document.addEventListener("DOMContentLoaded", () => {
            switchLevel(1);
        });
    </script>
</body>
</html>
